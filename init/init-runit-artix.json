{
  "init_name": "runit",

  "services": {
    "start": "env SVDIR=/run/runit/service sv start {service_name}",
    "stop": "env SVDIR=/run/runit/service sv stop {service_name}",
    "restart": "env SVDIR=/run/runit/service sv restart {service_name}",
    "enable": "ln -sf /etc/runit/sv/{service_name} /etc/runit/runsvdir/default/{service_name}",
    "disable": "rm -f /etc/runit/runsvdir/default/{service_name}",
    "status": "env SVDIR=/run/runit/service sv status {service_name}",
    "is_enabled": "test -L /etc/runit/runsvdir/default/{service_name}",
    "reload": "env SVDIR=/run/runit/service sv reload {service_name}",
    "daemon_reload": "",
    "list_managed": "ls /etc/runit/runsvdir/default/"
  }
}
