{
  "init_name": "systemd",

  "services": {
    "start": "systemctl start {service_name}",
    "stop": "systemctl stop {service_name}",
    "restart": "systemctl restart {service_name}",
    "enable": "systemctl enable {service_name}",
    "disable": "systemctl disable {service_name}",
    "status": "systemctl is-active {service_name}",
    "is_enabled": "systemctl is-enabled {service_name} >/dev/null 2>&1 && echo yes",
    "reload": "systemctl reload {service_name}",
    "daemon_reload": "systemctl daemon-reload",
    "list_all": "systemctl list-unit-files --type=service --no-legend --plain | cut -d' ' -f1 | sed -n 's/\\.service$//p' | grep -v '@$'",
    "is_running": "systemctl is-active --quiet {service_name} >/dev/null 2>&1 && echo yes",
    "list_managed": "systemctl list-units --type=service --no-pager --plain --no-legend"
  }
}
