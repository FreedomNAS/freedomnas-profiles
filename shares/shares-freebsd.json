{
  "samba": {
    "config_file": "/usr/local/etc/smb4.conf",
    "testparm": "testparm -s {config_file}",
    "create_share": "net usershare add {share_name} {path} {comment} {acl}",
    "list_shares": "net usershare list",
    "delete_share": "net usershare delete {share_name}",
    "check_installed": "testparm -V",
    "set_user_password": "smbpasswd -a -s {username}",
    "password_stdin_format": "{password}\n{password}\n",
    "delete_user": "smbpasswd -x {username}",
    "smb_service": "samba_server",
    "nmb_service": "samba_server",
    "reload_config": "smbcontrol smbd reload-config",
    "usershare_path": "/var/db/samba4/usershares",
    "usershare_prepare": "install -d -m 1770 {path}",
    "group_share_settings": []
  },
  "nfs": {
    "config_file": "/etc/exports",
    "export_add": "p={path}; o={options}; c={clients}; o=${{o#,}}; case $c in '*') c='';; */*) c=\"-network $c\";; esac; line=\"$p${{o:+ -$o}}${{c:+ $c}}\"; grep -qxF \"$line\" /etc/exports || echo \"$line\" >> /etc/exports",
    "default_options": "",
    "owner_options": ",mapall={owner}",
    "export_remove": "P={path} awk '$1 != ENVIRON[\"P\"]' /etc/exports > /etc/exports.new && mv /etc/exports.new /etc/exports",
    "export_list": "showmount -e localhost",
    "exportfs_reload": "service mountd status >/dev/null 2>&1 && service mountd onereload || service mountd onestart",
    "exportfs_list": "showmount -e localhost",
    "nfs_service": "nfsd"
  }
}
