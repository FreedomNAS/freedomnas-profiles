{
  "category": "nfs",
  "description": "NFS (Network File System) — Unix/Linux network shares",
  "debian": {
    "packages": [
      "nfs-kernel-server",
      "nfs-common",
      "rpcbind",
      "libnfsidmap2"
    ],
    "services": [
      "nfs-server",
      "rpcbind"
    ],
    "config_paths": [
      "/etc/exports",
      "/etc/idmapd.conf"
    ]
  },
  "freebsd": {
    "packages": [],
    "services": [
      "rpcbind",
      "mountd",
      "nfsd"
    ],
    "config_paths": [
      "/etc/exports"
    ]
  },
  "arch": {
    "packages": [
      "nfs-utils"
    ],
    "services": [
      "nfs-server",
      "rpcbind"
    ],
    "config_paths": [
      "/etc/exports",
      "/etc/idmapd.conf"
    ]
  },
  "artix": {
    "packages": [
      "nfs-utils"
    ],
    "init": {
      "openrc": {
        "packages": [
          "nfs-utils-openrc",
          "rpcbind-openrc"
        ],
        "services": [
          "rpcbind",
          "nfs"
        ]
      },
      "dinit": {
        "packages": [
          "nfs-utils-dinit",
          "rpcbind-dinit"
        ],
        "services": [
          "rpcbind",
          "nfs-server"
        ]
      },
      "runit": {
        "packages": [
          "nfs-utils-runit",
          "rpcbind-runit"
        ],
        "services": [
          "rpcbind",
          "nfs-server"
        ]
      }
    },
    "config_paths": [
      "/etc/exports",
      "/etc/idmapd.conf"
    ]
  },
  "void": {
    "packages": [
      "nfs-utils"
    ],
    "services": [
      "nfsd",
      "rpcbind"
    ],
    "config_paths": [
      "/etc/exports",
      "/etc/idmapd.conf"
    ]
  },
  "gentoo": {
    "packages": [
      "net-fs/nfs-utils",
      "net-nds/rpcbind"
    ],
    "services": [
      "nfs",
      "rpcbind"
    ],
    "config_paths": [
      "/etc/exports",
      "/etc/idmapd.conf"
    ]
  }
}
