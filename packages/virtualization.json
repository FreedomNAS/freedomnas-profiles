{
  "category": "virtualization",
  "description": "Virtualization hypervisor — KVM/Bhyve for running virtual machines",
  "debian": {
    "packages": [
      "qemu-kvm",
      "qemu-system-x86",
      "libvirt-daemon",
      "libvirt-clients",
      "bridge-utils",
      "virt-manager",
      "ovmf"
    ],
    "services": [
      "libvirtd"
    ],
    "config_paths": [
      "/etc/libvirt/libvirtd.conf",
      "/etc/libvirt/qemu.conf"
    ]
  },
  "freebsd": {
    "packages": [
      "bhyve",
      "libvirt",
      "vm-bhyve",
      "grub2-bhyve"
    ],
    "services": [
      "libvirtd"
    ],
    "config_paths": [
      "/etc/libvirt/libvirtd.conf"
    ]
  },
  "arch": {
    "packages": [
      "qemu-full",
      "libvirt",
      "virt-manager",
      "bridge-utils",
      "ovmf",
      "dnsmasq"
    ],
    "services": [
      "libvirtd"
    ],
    "config_paths": [
      "/etc/libvirt/libvirtd.conf",
      "/etc/libvirt/qemu.conf"
    ]
  },
  "artix": {
    "packages": [
      "qemu-full",
      "libvirt",
      "virt-manager",
      "bridge-utils",
      "ovmf",
      "dnsmasq"
    ],
    "init": {
      "openrc": {
        "packages": [
          "libvirt-openrc"
        ],
        "services": [
          "libvirtd"
        ]
      },
      "dinit": {
        "packages": [
          "libvirt-dinit"
        ],
        "services": [
          "libvirtd"
        ]
      }
    },
    "config_paths": [
      "/etc/libvirt/libvirtd.conf",
      "/etc/libvirt/qemu.conf"
    ]
  },
  "void": {
    "packages": [
      "qemu",
      "libvirt",
      "virt-manager",
      "bridge-utils",
      "ovmf",
      "dnsmasq"
    ],
    "services": [
      "libvirtd"
    ],
    "config_paths": [
      "/etc/libvirt/libvirtd.conf",
      "/etc/libvirt/qemu.conf"
    ]
  },
  "gentoo": {
    "packages": [
      "app-emulation/qemu",
      "app-emulation/libvirt",
      "app-emulation/virt-manager",
      "net-misc/bridge-utils",
      "sys-firmware/edk2-bin",
      "net-dns/dnsmasq"
    ],
    "services": [
      "libvirtd"
    ],
    "config_paths": [
      "/etc/libvirt/libvirtd.conf",
      "/etc/libvirt/qemu.conf"
    ]
  }
}
