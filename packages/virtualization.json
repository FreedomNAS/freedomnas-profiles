{
  "category": "virtualization",
  "description": "Virtualization hypervisor — QEMU with KVM on Linux, QEMU with NVMM on FreeBSD",
  "debian": {
    "packages": [
      "qemu-kvm",
      "qemu-system-x86",
      "libvirt-daemon",
      "libvirt-clients",
      "bridge-utils",
      "virt-manager",
      "ovmf"
    ],
    "admin_groups": [
      "libvirt"
    ],
    "services": [
      "libvirtd"
    ],
    "config_paths": [
      "/etc/libvirt/libvirtd.conf",
      "/etc/libvirt/qemu.conf"
    ]
  },
  "freebsd": {
    "packages": [
      "qemu-nox11",
      "freedomnas-nvmm"
    ],
    "admin_groups": [],
    "services": [],
    "config_paths": []
  },
  "arch": {
    "packages": [
      "qemu-full",
      "libvirt",
      "virt-manager",
      "edk2-ovmf",
      "dnsmasq"
    ],
    "admin_groups": [
      "libvirt"
    ],
    "services": [
      "libvirtd"
    ],
    "config_paths": [
      "/etc/libvirt/libvirtd.conf",
      "/etc/libvirt/qemu.conf"
    ]
  },
  "artix": {
    "packages": [
      "qemu-full",
      "libvirt",
      "virt-manager",
      "edk2-ovmf",
      "dnsmasq"
    ],
    "admin_groups": [
      "libvirt"
    ],
    "init": {
      "openrc": {
        "packages": [
          "libvirt-openrc"
        ],
        "services": [
          "libvirtd"
        ]
      },
      "dinit": {
        "packages": [
          "libvirt-dinit"
        ],
        "services": [
          "libvirtd"
        ]
      },
      "runit": {
        "packages": [
          "libvirt-runit"
        ],
        "services": [
          "libvirtd"
        ]
      }
    },
    "config_paths": [
      "/etc/libvirt/libvirtd.conf",
      "/etc/libvirt/qemu.conf"
    ]
  },
  "void": {
    "packages": [
      "qemu",
      "libvirt",
      "virt-manager",
      "bridge-utils",
      "edk2-ovmf",
      "dnsmasq"
    ],
    "admin_groups": [
      "libvirt"
    ],
    "services": [
      "libvirtd"
    ],
    "config_paths": [
      "/etc/libvirt/libvirtd.conf",
      "/etc/libvirt/qemu.conf"
    ]
  },
  "gentoo": {
    "packages": [
      "app-emulation/qemu",
      "app-emulation/libvirt",
      "app-emulation/virt-manager",
      "net-misc/bridge-utils",
      "sys-firmware/edk2-bin",
      "net-dns/dnsmasq"
    ],
    "admin_groups": [
      "libvirt"
    ],
    "services": [
      "libvirtd"
    ],
    "config_paths": [
      "/etc/libvirt/libvirtd.conf",
      "/etc/libvirt/qemu.conf"
    ]
  }
}
