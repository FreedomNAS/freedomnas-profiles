{
  "category": "containers",
  "description": "Container runtime — Docker on Linux, AppJail on FreeBSD",
  "debian": {
    "packages": [
      "docker-ce",
      "docker-ce-cli",
      "containerd.io",
      "docker-buildx-plugin",
      "docker-compose-plugin"
    ],
    "admin_groups": [
      "docker"
    ],
    "services": [
      "docker",
      "containerd"
    ],
    "config_paths": [
      "/etc/docker/daemon.json"
    ]
  },
  "freebsd": {
    "packages": [
      "appjail",
      "py312-director",
      "dnsmasq"
    ],
    "admin_groups": [],
    "services": [
      "appjail-natnet",
      "appjail-health",
      "appjail"
    ],
    "config_paths": [
      "/usr/local/etc/appjail/appjail.conf",
      "/usr/local/etc/containers/storage.conf"
    ]
  },
  "arch": {
    "packages": [
      "docker",
      "docker-compose",
      "containerd"
    ],
    "admin_groups": [
      "docker"
    ],
    "services": [
      "docker",
      "containerd"
    ],
    "config_paths": [
      "/etc/docker/daemon.json"
    ]
  },
  "artix": {
    "packages": [
      "docker",
      "docker-compose",
      "containerd"
    ],
    "admin_groups": [
      "docker"
    ],
    "init": {
      "openrc": {
        "packages": [
          "docker-openrc",
          "containerd-openrc"
        ],
        "services": [
          "containerd",
          "docker"
        ]
      },
      "dinit": {
        "packages": [
          "docker-dinit"
        ],
        "services": [
          "dockerd"
        ]
      },
      "runit": {
        "packages": [
          "docker-runit"
        ],
        "services": [
          "docker"
        ]
      }
    },
    "config_paths": [
      "/etc/docker/daemon.json"
    ]
  },
  "void": {
    "packages": [
      "docker",
      "docker-compose",
      "containerd"
    ],
    "admin_groups": [
      "docker"
    ],
    "services": [
      "docker",
      "containerd"
    ],
    "config_paths": [
      "/etc/docker/daemon.json"
    ]
  },
  "gentoo": {
    "packages": [
      "app-containers/docker",
      "app-containers/docker-cli",
      "app-containers/containerd",
      "app-containers/docker-compose"
    ],
    "admin_groups": [
      "docker"
    ],
    "services": [
      "docker",
      "containerd"
    ],
    "config_paths": [
      "/etc/docker/daemon.json"
    ]
  }
}
