{
  "category": "samba-cifs",
  "description": "SMB/CIFS file sharing — Windows-compatible network shares",
  "debian": {
    "packages": [
      "samba",
      "samba-common-bin",
      "samba-dsdb-modules",
      "winbind",
      "libpam-winbind",
      "libnss-winbind"
    ],
    "services": [
      "smbd",
      "nmbd",
      "winbind"
    ],
    "config_paths": [
      "/etc/samba/smb.conf"
    ]
  },
  "freebsd": {
    "packages": [
      "samba416",
      "winbind"
    ],
    "services": [
      "samba"
    ],
    "config_paths": [
      "/usr/local/etc/smb.conf"
    ]
  },
  "arch": {
    "packages": [
      "samba"
    ],
    "services": [
      "smb",
      "nmb",
      "winbind"
    ],
    "config_paths": [
      "/etc/samba/smb.conf"
    ]
  },
  "artix": {
    "packages": [
      "samba"
    ],
    "init": {
      "openrc": {
        "packages": [
          "samba-openrc"
        ],
        "services": [
          "smb"
        ]
      },
      "dinit": {
        "packages": [
          "samba-dinit"
        ],
        "services": [
          "smbd",
          "nmbd",
          "winbindd"
        ]
      },
      "runit": {
        "packages": [
          "samba-runit"
        ],
        "services": [
          "smbd",
          "nmbd"
        ]
      }
    },
    "config_paths": [
      "/etc/samba/smb.conf"
    ]
  },
  "void": {
    "packages": [
      "samba"
    ],
    "services": [
      "smbd",
      "nmbd"
    ],
    "config_paths": [
      "/etc/samba/smb.conf"
    ]
  },
  "gentoo": {
    "packages": [
      "net-fs/samba"
    ],
    "services": [
      "samba"
    ],
    "config_paths": [
      "/etc/samba/smb.conf"
    ]
  }
}
