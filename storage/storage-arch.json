{
  "zfs": {
    "pool_create": "zpool create -o ashift={ashift} -O compression={compression} -O acltype=posixacl {pool_name} {vdev_type} {devices}",
    "pool_import": "zpool import -d /dev/disk/by-id {pool_name}",
    "pool_export": "zpool export {pool_name}",
    "pool_destroy": "zpool destroy {pool_name}",
    "pool_importable": "zpool import -d /dev/disk/by-id",
    "pool_import_inspect": "zpool import -N -t -o readonly=on -o cachefile=none {force} -d /dev/disk/by-id {pool_id} {pool_name}",
    "pool_import_id": "zpool import -N {force} -d /dev/disk/by-id {pool_id} {pool_name}",
    "dataset_tree": "zfs get -rHp -t filesystem -o name,property,value,source mountpoint,canmount,encryption,encryptionroot,keyformat,keystatus,used {pool_name}",
    "load_key_prompt": "zfs load-key -L prompt {dataset}",
    "pool_acltype": "posix",
    "acltype_list": "zfs get -rH -t filesystem -o name,value,source acltype {pool_name}",
    "pool_cachefile_default": "zpool set cachefile= {pool_name}",
    "mount_pool_auto": "zfs list -rH -t filesystem -o name,canmount,mountpoint,mounted {pool_name} | awk -F '\\t' '$2 == \"on\" && $3 != \"none\" && $3 != \"legacy\" && $4 == \"no\" {{ print $1 }}' | xargs -r -n1 zfs mount",
    "pool_status": "zpool status -p {pool_name}",
    "pool_list": "zpool list -Hp -o name,size,alloc,free,capacity,health",
    "pool_scrub": "zpool scrub {pool_name}",
    "pool_scrub_stop": "zpool scrub -s {pool_name}",
    "pool_offline": "zpool offline {pool_name} {device}",
    "pool_online": "zpool online {pool_name} {device}",
    "pool_leaf_devices": "zpool list -vHP {pool_name}",
    "partition_of": "lsblk -bnrpo PKNAME,PARTN,START,SIZE {device} | awk '{{ print $1, $2, $3 * 512, $4 }}'",
    "disk_size": "lsblk -bdnro SIZE {disk}",
    "partition_offsets": "lsblk -bnrpo START,TYPE {disk} | awk '$2 == \"part\" {{ print $1 * 512 }}'",
    "_note": "partition_grow's last step zeroes the last MiB of the grown partition, where zpool online -e will write labels 2 and 3. On a stick that held an older, already grown image, that is where the old pool's labels still are, with a higher txg than the new pool's: ZFS then takes them as the vdev's and faults the root pool. The area lies past the pool's current end, so no data is touched.",
    "partition_grow": [
      "sfdisk --relocate gpt-bak-std {disk}",
      "echo ', +' | sfdisk --no-reread --no-tell-kernel -N {part_num} {disk}",
      "partx -u {disk}",
      "dd if=/dev/zero of={device} bs=256K count=4 seek=$(( $(blockdev --getsize64 {device}) / 262144 - 4 )) conv=fsync status=none"
    ],
    "pool_expand": "zpool online -e {pool_name} {device}",
    "dataset_create": "zfs create -o mountpoint={mountpoint} {pool_name}/{dataset_name}",
    "dataset_create_with": "zfs create {options} {dataset}",
    "dataset_rename": "zfs rename {dataset} {new_name}",
    "dataset_list": "zfs list -Hp -o name,used,avail,refer,mountpoint,type,mounted,origin",
    "dataset_get": "zfs get -H -o property,value,source all {dataset}",
    "dataset_set": "zfs set {property}={value} {dataset}",
    "dataset_inherit": "zfs inherit {property} {dataset}",
    "dataset_destroy": "zfs destroy {dataset}",
    "dataset_destroy_recursive": "zfs destroy -r {dataset}",
    "snapshot_create": "zfs snapshot {dataset}@{snap_name}",
    "snapshot_create_recursive": "zfs snapshot -r {dataset}@{snap_name}",
    "snapshot_rollback": "zfs rollback {dataset}@{snap_name}",
    "snapshot_list": "zfs list -t snapshot -Hp -o name,creation,used,referenced,userrefs,clones",
    "snapshot_destroy": "zfs destroy {dataset}@{snap_name}",
    "snapshot_clone": "zfs clone {snapshot} {clone_name}",
    "mount_dataset": "zfs mount {dataset}",
    "create_state_dataset": "zfs create -o canmount=noauto -o mountpoint=/etc/freedomnas/state {pool_name}/.freedomnas",
    "dataset_at_path": "zfs list -H -o name {path}",
    "mount_dataset_at": "mount -o zfsutil -t zfs {dataset} {mountpoint}",
    "unmount_at": "umount {mountpoint}",
    "unmount_dataset": "zfs unmount {dataset}",
    "get_used": "zfs get -Hp used {dataset}",
    "get_available": "zfs get -Hp avail {dataset}",
    "pool_create_encrypted": "zpool create -o ashift={ashift} -O compression={compression} -O acltype=posixacl -O encryption=aes-256-gcm -O keyformat=raw -O keylocation=file://{keyfile_path} {pool_name} {vdev_type} {devices}",
    "pool_keystatus": "zfs get -H -o value keystatus {pool_name}",
    "load_key_file": "zfs load-key -L file://{keyfile_path} {pool_name}",
    "unload_key": "zfs unload-key {pool_name}",
    "mount_all": "zfs mount -a",
    "mount_pool": "zfs list -rH -o name {pool_name} | xargs -r -n1 zfs mount",
    "dataset_get_property": "zfs get -H -o value,source {property} {dataset}",
    "pool_add_cache": "zpool add {pool_name} cache {devices}",
    "pool_add_log": "zpool add {pool_name} log {devices}",
    "pool_remove_device": "zpool remove {pool_name} {device}",
    "pool_member_devices": "zpool status -LP",
    "pool_status_json": "zpool status -j --json-int -P {pool_name}",
    "pool_scrub_pause": "zpool scrub -p {pool_name}",
    "pool_trim": "zpool trim {pool_name}",
    "pool_trim_suspend": "zpool trim -s {pool_name}",
    "pool_trim_cancel": "zpool trim -c {pool_name}",
    "pool_initialize": "zpool initialize {pool_name}",
    "pool_initialize_cancel": "zpool initialize -c {pool_name}",
    "pool_clear": "zpool clear {pool_name}",
    "pool_clear_device": "zpool clear {pool_name} {device}",
    "pool_offline_temporary": "zpool offline -t {pool_name} {device}",
    "pool_replace": "zpool replace {pool_name} {device} {new_device}",
    "pool_replace_in_place": "zpool replace {pool_name} {device}",
    "pool_attach": "zpool attach {pool_name} {device} {new_device}",
    "pool_detach": "zpool detach {pool_name} {device}",
    "pool_add_vdevs": "zpool add {pool_name} {devices}",
    "pool_remove_cancel": "zpool remove -s {pool_name}",
    "pool_upgrade": "zpool upgrade {pool_name}",
    "pool_history": "zpool history -l {pool_name}",
    "pool_history_internal": "zpool history -il {pool_name}",
    "pool_get_all": "zpool get -Hp -o property,value,source all {pool_name}",
    "pool_set": "zpool set {property}={value} {pool_name}",
    "pool_checkpoint": "zpool checkpoint {pool_name}",
    "pool_checkpoint_discard": "zpool checkpoint -d {pool_name}",
    "pool_reguid": "zpool reguid {pool_name}",
    "snapshot_destroy_recursive": "zfs destroy -r {dataset}@{snap_name}",
    "snapshot_rollback_recursive": "zfs rollback -r {dataset}@{snap_name}",
    "snapshot_rename": "zfs rename {snapshot} {new_snapshot}",
    "snapshot_holds": "zfs holds -Hp {snapshot}",
    "snapshot_hold": "zfs hold {tag} {snapshot}",
    "snapshot_release": "zfs release {tag} {snapshot}",
    "snapshot_diff": "zfs diff -FHt {snapshot}",
    "snapshot_diff_to": "zfs diff -FHt {snapshot} {target}",
    "bookmark_list": "zfs list -t bookmark -Hp -o name,creation",
    "bookmark_create": "zfs bookmark {snapshot} {bookmark}",
    "bookmark_destroy": "zfs destroy {bookmark}",
    "volume_create": "zfs create -V {size} {options} {dataset}",
    "volume_create_sparse": "zfs create -s -V {size} {options} {dataset}",
    "dataset_promote": "zfs promote {dataset}",
    "userspace": "zfs userspace -Hp -o type,name,used,quota,objused,objquota {dataset}",
    "groupspace": "zfs groupspace -Hp -o type,name,used,quota,objused,objquota {dataset}",
    "replicate": "echo $$ > {pid_file}; zfs send -vP {send_flags} {incremental} {snapshot} 2> {progress_file} | zfs receive {receive_flags} {target}",
    "replicate_resume": "echo $$ > {pid_file}; zfs send -vP -t {token} 2> {progress_file} | zfs receive -s {receive_flags} {target}",
    "send_to_file": "echo $$ > {pid_file}; set -C; zfs send -vP {send_flags} {incremental} {snapshot} 2> {progress_file} > {file}",
    "receive_from_file": "echo $$ > {pid_file}; zfs receive {receive_flags} {target} < {file}",
    "receive_abort": "zfs receive -A {target}",
    "send_estimate": "zfs send -nvP {send_flags} {incremental} {snapshot}",
    "replication_cancel": "pkill -INT -P {pid}",
    "resume_tokens": "zfs get -Hp -t filesystem,volume -o name,value receive_resume_token",
    "multi_args": [
      "devices",
      "vdev_type",
      "force",
      "options",
      "send_flags",
      "receive_flags",
      "incremental"
    ]
  },
  "media": {
    "list_removable": "lsblk -rno NAME,RM,TYPE",
    "mount_ro": "mount -o ro,noexec,nosuid,nodev {device} {mountpoint}",
    "mount_rw": "mount {device} {mountpoint}",
    "unmount": "umount {mountpoint}",
    "list_devices": "lsblk -pbP -o NAME,PKNAME,SIZE,TYPE,FSTYPE,MOUNTPOINT,MODEL,PARTTYPE",
    "smart_scan": "smartctl --scan -j",
    "smart_info": "smartctl -a -j -n standby {device}",
    "smart_test": "smartctl -t {test_type} {device}"
  },
  "directories": {
    "owner_get": "stat -c %U {path}",
    "owner_uid_get": "stat -c %u {path}",
    "owner_group": "{owner}",
    "group_get": "stat -c %G {path}",
    "group_set": "chgrp {group} {path}",
    "group_set_recursive": "chgrp -R {group} {path}",
    "owner_set": "chown {owner} {path}",
    "mode_set": "chmod {mode} {path}"
  },
  "zfs_properties": {
    "acltype": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "off",
        "posix",
        "nfsv4"
      ],
      "help": "ACL flavour. 'posix' is what Linux tools expect.",
      "default": "off"
    },
    "atime": {
      "level": "assisted",
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "help": "Update access times on read. Off saves writes on a busy share.",
      "default": "on"
    },
    "canmount": {
      "level": "expert",
      "type": "enum",
      "values": [
        "on",
        "off",
        "noauto"
      ],
      "help": "Whether the dataset mounts at all. 'off' makes it a container.",
      "default": "on"
    },
    "casesensitivity": {
      "level": "expert",
      "type": "enum",
      "values": [
        "sensitive",
        "insensitive",
        "mixed"
      ],
      "help": "Set once, at creation. 'mixed' is what Samba shares usually want.",
      "default": "sensitive",
      "create_only": true
    },
    "checksum": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "on",
        "fletcher2",
        "fletcher4",
        "sha256",
        "sha512",
        "skein",
        "edonr",
        "blake3"
      ],
      "help": "Checksum algorithm for data integrity.",
      "default": "on"
    },
    "compression": {
      "level": "assisted",
      "type": "enum",
      "values": [
        "off",
        "on",
        "lz4",
        "zstd",
        "zstd-fast",
        "gzip",
        "gzip-9",
        "zle",
        "lzjb"
      ],
      "help": "Transparent compression. lz4 is nearly free; zstd trades CPU for space.",
      "default": "lz4"
    },
    "copies": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "1",
        "2",
        "3"
      ],
      "help": "Copies of each block within the same pool — not a substitute for redundancy.",
      "default": "1"
    },
    "dedup": {
      "level": "expert",
      "type": "enum",
      "values": [
        "off",
        "on",
        "verify",
        "sha256,verify",
        "blake3,verify"
      ],
      "help": "Deduplication. Needs several GB of RAM per TB and is hard to undo.",
      "default": "off"
    },
    "devices": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "help": "Allow device nodes to be opened.",
      "default": "on"
    },
    "dnodesize": {
      "level": "expert",
      "type": "enum",
      "values": [
        "legacy",
        "auto",
        "1k",
        "2k",
        "4k",
        "8k",
        "16k"
      ],
      "help": "Dnode size. 'auto' suits datasets with long names or many xattrs.",
      "default": "legacy"
    },
    "exec": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "help": "Allow executing files from this dataset.",
      "default": "on"
    },
    "logbias": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "latency",
        "throughput"
      ],
      "help": "Optimise the intent log for response time or for bulk throughput.",
      "default": "latency"
    },
    "normalization": {
      "level": "expert",
      "type": "enum",
      "values": [
        "none",
        "formC",
        "formD",
        "formKC",
        "formKD"
      ],
      "help": "Unicode normalisation of file names. Set once, at creation.",
      "default": "none",
      "create_only": true
    },
    "overlay": {
      "level": "expert",
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "help": "Allow mounting over a non-empty directory.",
      "default": "on"
    },
    "primarycache": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "all",
        "metadata",
        "none"
      ],
      "help": "What the ARC (RAM cache) keeps.",
      "default": "all"
    },
    "quota": {
      "level": "assisted",
      "type": "size",
      "help": "Hard limit on what this dataset and its children may use."
    },
    "readonly": {
      "level": "assisted",
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "help": "Refuse every write to this dataset.",
      "default": "off"
    },
    "recordsize": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "512",
        "4K",
        "8K",
        "16K",
        "32K",
        "64K",
        "128K",
        "256K",
        "512K",
        "1M"
      ],
      "help": "Largest block written. Lower for databases, higher for big files.",
      "default": "128K"
    },
    "redundant_metadata": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "all",
        "most"
      ],
      "help": "Extra copies of metadata. 'most' trades some resilience for speed.",
      "default": "all"
    },
    "refquota": {
      "level": "advanced",
      "type": "size",
      "help": "Limit that ignores snapshots and children."
    },
    "refreservation": {
      "level": "advanced",
      "type": "size",
      "help": "Guarantee that ignores snapshots and children."
    },
    "relatime": {
      "level": "assisted",
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "help": "Update access times only when they are older than the modification time.",
      "default": "on"
    },
    "reservation": {
      "level": "assisted",
      "type": "size",
      "help": "Space guaranteed to this dataset."
    },
    "secondarycache": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "all",
        "metadata",
        "none"
      ],
      "help": "What the L2ARC (cache device) keeps.",
      "default": "all"
    },
    "setuid": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "help": "Honour setuid bits.",
      "default": "on"
    },
    "snapdev": {
      "level": "expert",
      "type": "enum",
      "values": [
        "hidden",
        "visible"
      ],
      "help": "Whether volume snapshots get device nodes.",
      "default": "hidden"
    },
    "snapdir": {
      "level": "assisted",
      "type": "enum",
      "values": [
        "hidden",
        "visible"
      ],
      "help": "Whether .zfs/snapshot is visible in the directory listing.",
      "default": "hidden"
    },
    "special_small_blocks": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "0",
        "4K",
        "8K",
        "16K",
        "32K",
        "64K",
        "128K"
      ],
      "help": "Blocks up to this size go to the special vdev, if the pool has one.",
      "default": "0"
    },
    "sync": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "standard",
        "always",
        "disabled"
      ],
      "help": "How synchronous writes are honoured. 'disabled' risks the last seconds on a crash.",
      "default": "standard"
    },
    "volmode": {
      "level": "expert",
      "type": "enum",
      "values": [
        "default",
        "full",
        "geom",
        "dev",
        "none"
      ],
      "help": "How a volume is exposed to the system.",
      "default": "default"
    },
    "xattr": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "on",
        "off",
        "sa"
      ],
      "help": "Extended attributes. 'sa' stores them inline and is much faster.",
      "default": "on"
    }
  },
  "zpool_properties": {
    "autotrim": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "default": "off",
      "help": "TRIM freed space automatically. Useful when the pool is on SSDs."
    },
    "autoexpand": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "default": "off",
      "help": "Grow the pool by itself once every disk of a vdev has been replaced by a bigger one."
    },
    "autoreplace": {
      "level": "advanced",
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "default": "off",
      "help": "A new disk put in the slot of a failed one replaces it without asking."
    },
    "comment": {
      "level": "advanced",
      "type": "text",
      "help": "Free text stored in the pool, shown when it is imported elsewhere."
    },
    "failmode": {
      "level": "expert",
      "type": "enum",
      "values": [
        "wait",
        "continue",
        "panic"
      ],
      "default": "wait",
      "help": "What happens when the pool loses too many devices to keep working."
    },
    "listsnapshots": {
      "level": "expert",
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "default": "off",
      "help": "Show snapshots in a plain zfs list."
    },
    "delegation": {
      "level": "expert",
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "default": "on",
      "help": "Allow ordinary users the permissions given with zfs allow."
    },
    "multihost": {
      "level": "expert",
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "default": "off",
      "help": "Protect a pool on shared storage from being imported by two systems at once."
    },
    "compatibility": {
      "level": "expert",
      "type": "text",
      "help": "Limit the features to a set that another system can read: off, legacy, or a file name such as openzfs-2.1-linux."
    }
  }
}
