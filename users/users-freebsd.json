{
  "users": {
    "create": "pw useradd {username} -m -s /bin/sh -G {groups}",
    "create_with_uid": "pw useradd {username} -m -u {uid} -s /bin/sh -G {groups}",
    "uid_set": "sh -c 'home=$(pw usershow \"$1\" | cut -d: -f9) && pw usermod \"$1\" -u \"$2\" && {{ [ ! -d \"$home\" ] || chown -R \"$2\" \"$home\"; }}' uid_set {username} {uid}",
    "gid_set": "sh -c 'pw groupmod \"$1\" -g \"$2\" && pw usermod \"$3\" -g \"$2\"' gid_set {group} {gid} {username}",
    "group_gid_set": "pw groupmod {group} -g {gid}",
    "group_exists": "pw groupshow {group}",
    "delete": "pw userdel {username} -r",
    "delete_keep_home": "pw userdel {username}",
    "list": "pw usershow -a | awk -F: '$3 >= 1001 && $3 < 65534'",
    "get_user_info": "pw usershow {username}",
    "list_groups": "id -nG {username}",
    "add_to_group": "pw groupmod {group} -m {username}",
    "remove_from_group": "pw groupmod {group} -d {username}",
    "create_basic": "pw useradd {username} -m -s /bin/sh",
    "set_password_stdin": "pw usermod {username} -h 0",
    "password_stdin_format": "{password}\n",
    "sudo_group": "wheel",
    "lock_root": "pw lock root",
    "group_create": "pw groupadd {group}",
    "group_delete": "pw groupdel {group}",
    "password_expire": "pw usermod {username} -p 1",
    "password_fresh": "pw usermod {username} -p 0"
  }
}
