{
  "users": {
    "create": "useradd -m -s /bin/bash -G {groups} {username}",
    "create_with_uid": "useradd -m -u {uid} -s /bin/bash -G {groups} {username}",
    "uid_set": "usermod -u {uid} {username}",
    "gid_set": "groupmod -g {gid} {group}",
    "group_exists": "getent group {group}",
    "delete": "userdel -r {username}",
    "delete_keep_home": "userdel {username}",
    "list": "getent passwd | awk -F: '$3 >= 1000 && $3 < 65534'",
    "get_user_info": "getent passwd {username}",
    "list_groups": "id -nG {username}",
    "add_to_group": "usermod -a -G {group} {username}",
    "remove_from_group": "gpasswd -d {username} {group}",
    "create_basic": "useradd -m -s /bin/bash {username}",
    "set_password_stdin": "chpasswd",
    "password_stdin_format": "{username}:{password}\n",
    "sudo_group": "wheel",
    "group_create": "groupadd {group}",
    "group_delete": "groupdel {group}",
    "password_expire": "chage -d 0 {username}",
    "password_fresh": "chage -d -1 {username}"
  }
}
