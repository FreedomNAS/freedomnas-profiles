{
  "os_name": "FreeBSD",
  "os_family": "bsd",
  "os_version": "13.0+",
  "init_system": "bsd_rc",

  "users": {
    "create": "pw useradd {username} -m -s /usr/local/bin/bash -G {groups}",
    "delete": "pw userdel {username} -r",
    "set_password": "echo '{password}' | pw usermod {username} -h 0",
    "list": "pw usershow -a | awk -F: '$3 >= 1001 && $3 < 65534'",
    "get_user_info": "pw usershow {username}",
    "add_to_group": "pw groupmod {group} -m {username}",
    "remove_from_group": "pw groupmod {group} -d {username}"
  },

  "network": {
    "list_interfaces": "ifconfig -l -ether",
    "list_addresses": "ifconfig -a",
    "rename_interface": "ifconfig {old_name} name {new_name}",
    "bridge_create": [
      "ifconfig bridge create name {bridge_name}",
      "ifconfig {bridge_name} up"
    ],
    "bridge_add_port": "ifconfig {bridge_name} addm {interface}",
    "bridge_stp": "ifconfig {bridge_name} stp {interface}",
    "set_static_ip": [
      "sysrc ifconfig_{logical_name}=\"inet {ip} netmask {netmask}\"",
      "sysrc defaultrouter=\"{gateway}\""
    ],
    "set_dynamic_ip": "sysrc ifconfig_{logical_name}=dhcp",
    "bring_up_interface": "ifconfig {interface} up",
    "bring_down_interface": "ifconfig {interface} down",
    "hostname_set": "hostname {hostname} && sysrc hostname=\"{hostname}\"",
    "hostname_get": "hostname",
    "persistent_rename": "ifconfig_{old_name}_name=\"{logical_name}\""
  },

  "packages": {
    "update_cache": "pkg update",
    "list_updatable": "pkg upgrade -n --raw-format json-compact",
    "install": "pkg install -y {package_name}",
    "remove": "pkg remove -y {package_name}",
    "purge": "pkg delete -y -R {package_name}",
    "autoremove": "pkg autoremove -y",
    "search": "pkg search {package_name}",
    "show": "pkg info {package_name}",
    "upgrade": "pkg upgrade -y"
  },

  "zfs": {
    "pool_create": "zpool create -o ashift={ashift} -O compression={compression} -O acltype=nfsv4acl {pool_name} {vdev_type} {devices}",
    "pool_import": "zpool import {pool_name}",
    "pool_export": "zpool export {pool_name}",
    "pool_status": "zpool status -p {pool_name}",
    "pool_list": "zpool list -Hp",
    "pool_scrub": "zpool scrub {pool_name}",
    "pool_scrub_stop": "zpool scrub -s {pool_name}",
    "pool_offline": "zpool offline {pool_name} {device}",
    "pool_online": "zpool online {pool_name} {device}",
    "dataset_create": "zfs create -o mountpoint={mountpoint} {pool_name}/{dataset_name}",
    "dataset_list": "zfs list -Hp -o name,used,avail,refer,mountpoint",
    "dataset_get": "zfs get all {dataset}",
    "dataset_set": "zfs set {property}={value} {dataset}",
    "dataset_destroy": "zfs destroy {dataset}",
    "snapshot_create": "zfs snapshot {dataset}@{snap_name}",
    "snapshot_rollback": "zfs rollback {dataset}@{snap_name}",
    "snapshot_list": "zfs list -t snapshot -Hp -o name,creation,used",
    "snapshot_destroy": "zfs destroy {dataset}@{snap_name}",
    "snapshot_clone": "zfs clone {snapshot} {clone_name}",
    "mount_dataset": "zfs mount {dataset}",
    "unmount_dataset": "zfs unmount {dataset}",
    "get_used": "zfs get -Hp used {dataset}",
    "get_available": "zfs get -Hp avail {dataset}",
    "pool_create_encrypted": "zpool create -o ashift={ashift} -O compression={compression} -O acltype=nfsv4acl -O encryption=aes-256-gcm -O keyformat=raw -O keylocation=file://{keyfile_path} {pool_name} {vdev_type} {devices}",
    "pool_keystatus": "zfs get -H -o value keystatus {pool_name}",
    "load_key_file": "zfs load-key -L file://{keyfile_path} {pool_name}",
    "unload_key": "zfs unload-key {pool_name}",
    "mount_all": "zfs mount -a"
  },

  "media": {
    "_note": "Assumes FAT32-formatted USB sticks -- FreeBSD mount(8) does not autodetect filesystem type the way Linux mount does.",
    "list_removable": "camcontrol devlist -v",
    "mount_ro": "mount -t msdosfs -o ro {device} {mountpoint}",
    "mount_rw": "mount -t msdosfs {device} {mountpoint}",
    "unmount": "umount {mountpoint}"
  },

  "samba": {
    "config_file": "/usr/local/etc/smb4.conf",
    "testparm": "testparm -s {config_file}",
    "create_share": "net usershare add {share_name} {path} {comment} {acl}",
    "list_shares": "net usershare list",
    "delete_share": "net usershare delete {share_name}",
    "set_user_password": "smbpasswd -a {username}",
    "smb_service": "smbd",
    "nmb_service": "nmbd",
    "reload_config": "smbcontrol smbd reload-config"
  },

  "nfs": {
    "config_file": "/etc/exports",
    "export_list": "showmount -e localhost",
    "exportfs_reload": "exportfs -ra",
    "exportfs_list": "exportfs -v",
    "nfs_service": "nfs-server"
  },

  "bootloader": {
    "_note": "FreeBSD boots ZFS-on-root natively -- no UKI/Clover needed. gptzfsboot (BIOS) and loader.efi (UEFI) both understand the same GPT+ZFS layout directly, so one image is bootable both ways without a third-party shim.",
    "install_gptzfsboot": "gpart bootcode -b /boot/pmbr -p /boot/gptzfsboot -i {part_num} {disk}",
    "install_efi_loader": "cp /boot/loader.efi {esp_mount}/EFI/BOOT/BOOTX64.efi",
    "efi_boot_entry": "efibootmgr --create --disk {disk} --part {part_num} --loader {loader_path} --label {label}"
  },

  "system": {
    "hostname_set": "hostname {hostname} && sysrc hostname=\"{hostname}\"",
    "reboot": "shutdown -r now",
    "shutdown": "shutdown -p now",
    "uptime": "sysctl -n kern.boottime",
    "uname": "uname -a",
    "cpu_info": "sysctl hw.model hw.ncpu",
    "memory_info": "sysctl hw.realmem hw.usermem",
    "disk_list": "geom disk list",
    "disk_partitions": "gpart show",
    "mount_list": "mount | column -t",
    "df": "df -h",
    "dmesg": "dmesg"
  }
}
