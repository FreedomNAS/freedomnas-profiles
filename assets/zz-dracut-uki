#!/bin/sh
# /etc/kernel/postinst.d/zz-dracut-uki
#
# Rebuilds the FreedomNAS UKI on every kernel install/update, and keeps the
# UKI the system runs on in a rollback slot (*-previous.efi), paired with
# the pre-update ZFS snapshot taken before the change.
#
#   zz-dracut-uki <kernel-version>        build the UKI for that kernel
#   zz-dracut-uki --backup [<snapshot>]   copy the running UKI to the slot
#   zz-dracut-uki --boot-ok [yes|no]      the system is up; automatic rollback on/off
#   zz-dracut-uki --autorollback yes|no   automatic rollback on/off
#   zz-dracut-uki --state                 print boot.state and the active UKI's kernel
#   zz-dracut-uki --forget-rollback       clear the record of a rollback
#
# The package managers' pre-install hooks and the WebUI's update call
# --backup before anything is installed; a call through
# /etc/kernel/preinst.d is a backup too. A build never replaces the UKI
# with one that has no zfs.ko, and rotates only when nothing backed the
# running UKI up first. A build that changes the kernel puts boot.state in
# "trial": the initramfs module 92freedomnas-fallback restores the rollback
# UKI if the new kernel does not boot.
#
# Must never abort a kernel install over a UKI or ZFS problem: log and
# continue. The pool name, the edition and the UKI filenames are decided
# when the system is installed, so they are read from
# /etc/freedomnas/uki.conf rather than written here.

set -u

mode=build
snapshot=""
case "${1:-}" in
    --backup) mode=backup; snapshot="${2:-}" ;;
    --boot-ok) mode=boot-ok; setting="${2:-}" ;;
    --autorollback) mode=autorollback; setting="${2:-}" ;;
    --state) mode=state ;;
    --forget-rollback) mode=forget ;;
    *) case "$0" in */preinst.d/*) mode=backup ;; esac
       version="${1:-$(uname -r)}" ;;
esac

esp_linux_dir="/boot/efi/EFI/Linux"
efi_fallback="/boot/efi/EFI/BOOT/BOOTX64.efi"

boot_state_dir="/boot/efi/EFI/FreedomNAS"
boot_state="$boot_state_dir/boot.state"

log() { echo "zz-dracut-uki: $*"; }

state_get() {
    sed -n "s/^$1: //p" "$boot_state" 2>/dev/null | head -n 1
}

state_set() {
    mkdir -p "$boot_state_dir" || return 1
    if grep -q "^$1:" "$boot_state" 2>/dev/null; then
        sed -i "s|^$1: .*|$1: $2|" "$boot_state"
    else
        echo "$1: $2" >> "$boot_state"
    fi
}

state_drop() {
    [ -f "$boot_state" ] && sed -i "/^$1:/d" "$boot_state"
}

ROOT_DATASET=""
UKI_NAME=""
UKI_RECOVERY_NAME=""
conf="/etc/freedomnas/uki.conf"
[ -r "$conf" ] && . "$conf"

if [ -z "$ROOT_DATASET" ] || [ -z "$UKI_NAME" ]; then
    log "no usable $conf, skipping"
    exit 0
fi

root_dataset="$ROOT_DATASET"
current="$esp_linux_dir/$UKI_NAME"
current_kernel="${current%.efi}.kernel"
previous="$esp_linux_dir/${UKI_NAME%.efi}-previous.efi"
previous_kernel="${previous%.efi}.kernel"
previous_snap="${previous%.efi}.snapshot"
recovery="$esp_linux_dir/$UKI_RECOVERY_NAME"

[ -d "$esp_linux_dir" ] || { log "no $esp_linux_dir, skipping (ESP not mounted?)"; exit 0; }

case "$mode" in
    state)
        cat "$boot_state" 2>/dev/null
        [ -r "$current_kernel" ] && echo "active-kernel: $(cat "$current_kernel")"
        exit 0
        ;;
    autorollback|boot-ok)
        case "$setting" in
            yes|no) state_set autorollback "$setting" ;;
            "") [ "$mode" = boot-ok ] || { log "--autorollback takes yes or no"; exit 1; } ;;
            *) log "autorollback must be yes or no, not $setting"; exit 1 ;;
        esac
        if [ "$mode" = boot-ok ]; then
            case "$(state_get state)" in
                trial|fallback-requested|rolled-back)
                    state_set state ok
                    state_drop tries-left
                    log "boot confirmed on kernel $(uname -r)"
                    ;;
            esac
        fi
        exit 0
        ;;
esac

if [ "$mode" = forget ]; then
    for key in failed-kernel restored-kernel reason date snapshot fs-rollback failed-dataset; do
        state_drop "$key"
    done
    rm -f "$esp_linux_dir/${UKI_NAME%.efi}-failed.efi" "$esp_linux_dir/${UKI_NAME%.efi}-failed.kernel"
    log "rollback record cleared"
    exit 0
fi

kernel_of() { [ -r "$1" ] && cat "$1"; }

pair_with() {
    if [ -n "$1" ]; then
        echo "$1" > "$previous_snap"
        log "previous UKI paired with snapshot $1"
    else
        rm -f "$previous_snap"
        log "WARNING: no pre-update snapshot taken since $current was built -- previous UKI has no matching filesystem state"
    fi
}

latest_snapshot_since_current() {
    built=$(stat -c %Y "$current" 2>/dev/null) || return 0
    zfs list -H -p -t snapshot -o name,creation -S creation "$root_dataset" 2>/dev/null \
        | awk -v r="${root_dataset}@pre-update-" -v t="$built" 'index($1, r) == 1 && $2 >= t {print $1; exit}'
}

copy_current_to_previous() {
    cp -f "$current" "$previous" || return 1
    if [ -r "$current_kernel" ]; then
        cp -f "$current_kernel" "$previous_kernel"
    else
        rm -f "$previous_kernel"
    fi
    log "copied $current (kernel $(kernel_of "$current_kernel" || echo unknown)) to $previous"
}

uki_has_zfs() {
    if ! command -v objcopy >/dev/null 2>&1 || ! command -v lsinitrd >/dev/null 2>&1; then
        log "WARNING: objcopy or lsinitrd missing, cannot check $1 for zfs.ko"
        return 0
    fi
    check_dir=$(mktemp -d) || return 0
    objcopy -O binary --only-section=.initrd "$1" "$check_dir/initrd" 2>/dev/null \
        && lsinitrd "$check_dir/initrd" 2>/dev/null | grep -q '/zfs\.ko'
    found=$?
    rm -rf "$check_dir"
    return "$found"
}

if [ "$mode" = backup ]; then
    [ -f "$current" ] || { log "no $current, nothing to back up"; exit 0; }
    running=$(uname -r)
    cur_kernel=$(kernel_of "$current_kernel" || true)
    if [ -n "$cur_kernel" ] && [ "$cur_kernel" != "$running" ]; then
        log "running kernel $running is not the one in $current ($cur_kernel): $previous left as it is"
        exit 0
    fi
    if [ -n "$snapshot" ]; then
        case "$snapshot" in *@*) ;; *) snapshot="${root_dataset}@${snapshot}" ;; esac
        zfs list -H -t snapshot -o name "$snapshot" >/dev/null 2>&1 || snapshot=""
    fi
    if [ -n "$cur_kernel" ] && [ -f "$previous" ] && [ "$(kernel_of "$previous_kernel" || true)" = "$cur_kernel" ] \
            && cmp -s "$current" "$previous"; then
        [ -n "$snapshot" ] && pair_with "$snapshot"
        log "$previous already holds the running UKI"
        exit 0
    fi
    copy_current_to_previous || { log "ERROR: could not copy $current to $previous"; exit 1; }
    pair_with "${snapshot:-$(latest_snapshot_since_current)}"
    exit 0
fi

if [ "$(state_get failed-kernel)" = "$version" ]; then
    log "kernel $version failed to boot on $(state_get date) and was rolled back: not activated again until that rollback is cleared in the WebUI"
    exit 0
fi

if ! modinfo -k "$version" zfs >/dev/null 2>&1; then
    log "no zfs module for $version yet: $current and $efi_fallback left untouched"
    exit 0
fi

new="$current.new"
if ! dracut --force --uefi --kernel-cmdline "root=ZFS=${root_dataset} rw" "$new" "$version"; then
    rm -f "$new"
    log "ERROR: dracut failed building standard UKI for $version"
    exit 0
fi
if ! uki_has_zfs "$new"; then
    rm -f "$new"
    log "ERROR: the UKI built for $version has no zfs.ko: $current and $efi_fallback left untouched"
    exit 0
fi

trial=no
if [ -f "$current" ]; then
    cur_kernel=$(kernel_of "$current_kernel" || true)
    [ "$cur_kernel" != "$version" ] && trial=yes
    if [ "$cur_kernel" = "$version" ]; then
        log "$current already runs $version: rebuilt in place, $previous unchanged"
    elif [ -n "$cur_kernel" ] && [ "$(kernel_of "$previous_kernel" || true)" = "$cur_kernel" ] \
            && cmp -s "$current" "$previous"; then
        log "$previous was backed up before the update"
    elif copy_current_to_previous; then
        pair_with "$(latest_snapshot_since_current)"
    else
        log "WARNING: failed to rotate previous UKI, continuing anyway"
    fi
fi

mv -f "$new" "$current"
echo "$version" > "$current_kernel"
log "standard UKI rebuilt: $current"
if mkdir -p "${efi_fallback%/*}" && cp -f "$current" "$efi_fallback"; then
    log "UEFI fallback updated: $efi_fallback"
else
    log "WARNING: failed to update $efi_fallback, UEFI machines without an NVRAM entry boot the old kernel"
fi

if [ -n "$UKI_RECOVERY_NAME" ]; then
    if dracut --force --uefi \
            --kernel-cmdline "root=ZFS=${root_dataset} ro single rd.shell SYSTEMD_SULOGIN_FORCE=1 freedomnas.autorollback=0" "$recovery.new" "$version" \
            && uki_has_zfs "$recovery.new"; then
        mv -f "$recovery.new" "$recovery"
        log "recovery UKI rebuilt: $recovery"
    else
        rm -f "$recovery.new"
        log "WARNING: recovery UKI for $version not built, the old one is kept"
    fi
fi

if [ "$trial" = yes ] && [ -f "$previous" ]; then
    state_set state trial
    state_set trial-kernel "$version"
    state_set tries-left 3
    log "kernel $version is on trial: if it does not boot, the UKI of $(kernel_of "$previous_kernel" || echo the previous kernel) comes back by itself"
fi

exit 0
