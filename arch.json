{
  "os_name": "Arch Linux",
  "os_family": "linux",
  "os_version": "rolling",
  "init_system": "systemd",
  "community_maintained": true,
  "maintainer_note": "Community-maintained profile. Contributions welcome!",

  "users": {
    "create": "useradd -m -s /bin/bash -G {groups} {username}",
    "delete": "userdel -r {username}",
    "set_password": "echo '{username}:{password}' | chpasswd",
    "list": "getent passwd | awk -F: '$3 >= 1000 && $3 < 65534'",
    "get_user_info": "getent passwd {username}",
    "add_to_group": "usermod -a -G {groups} {username}",
    "remove_from_group": "delgroup {username} {group}"
  },

  "network": {
    "list_interfaces": "ip -j link show",
    "list_addresses": "ip -j address show",
    "rename_interface": [
      "ip link set {old_name} down",
      "ip link set {old_name} name {new_name}",
      "ip link set {new_name} up"
    ],
    "bridge_create": [
      "ip link add {bridge_name} type bridge",
      "ip link set {bridge_name} up"
    ],
    "bridge_add_port": "ip link set {interface} master {bridge_name}",
    "set_static_ip": [
      "ip addr add {ip}/{cidr} dev {interface}",
      "ip route add default via {gateway}"
    ],
    "set_dynamic_ip": "dhclient {interface}",
    "bring_up_interface": "ip link set {interface} up",
    "bring_down_interface": "ip link set {interface} down",
    "hostname_set": "hostnamectl set-hostname {hostname}",
    "hostname_get": "hostnamectl --static",
    "udev_persistent_rule": "SUBSYSTEM==\"net\", ACTION==\"add\", ATTR{{address}}==\"{mac}\", NAME=\"{logical_name}\""
  },

  "packages": {
    "update_cache": "pacman -Sy",
    "list_updatable": "pacman -Qu",
    "install": "pacman -S --noconfirm {package_name}",
    "remove": "pacman -R --noconfirm {package_name}",
    "purge": "pacman -Rns --noconfirm {package_name}",
    "autoremove": "pacman -Qdtq | pacman -Rs --noconfirm -",
    "search": "pacman -Ss {package_name}",
    "show": "pacman -Si {package_name}",
    "upgrade": "pacman -Syu --noconfirm"
  },

  "zfs": {
    "pool_create": "zpool create -o ashift={ashift} -O compression={compression} -O acltype=posixacl {pool_name} {vdev_type} {devices}",
    "pool_import": "zpool import -d /dev/disk/by-id {pool_name}",
    "pool_export": "zpool export {pool_name}",
    "pool_status": "zpool status -p {pool_name}",
    "pool_list": "zpool list -Hp",
    "pool_scrub": "zpool scrub {pool_name}",
    "pool_scrub_stop": "zpool scrub -s {pool_name}",
    "pool_offline": "zpool offline {pool_name} {device}",
    "pool_online": "zpool online {pool_name} {device}",
    "dataset_create": "zfs create -o mountpoint={mountpoint} {pool_name}/{dataset_name}",
    "dataset_list": "zfs list -Hp -o name,used,avail,refer,mountpoint",
    "dataset_get": "zfs get all {dataset}",
    "dataset_set": "zfs set {property}={value} {dataset}",
    "dataset_destroy": "zfs destroy {dataset}",
    "snapshot_create": "zfs snapshot {dataset}@{snap_name}",
    "snapshot_rollback": "zfs rollback {dataset}@{snap_name}",
    "snapshot_list": "zfs list -t snapshot -Hp -o name,creation,used",
    "snapshot_destroy": "zfs destroy {dataset}@{snap_name}",
    "snapshot_clone": "zfs clone {snapshot} {clone_name}",
    "mount_dataset": "zfs mount {dataset}",
    "unmount_dataset": "zfs unmount {dataset}",
    "get_used": "zfs get -Hp used {dataset}",
    "get_available": "zfs get -Hp avail {dataset}"
  },

  "samba": {
    "config_file": "/etc/samba/smb.conf",
    "testparm": "testparm -s {config_file}",
    "create_share": "net usershare add {share_name} {path} {comment} {acl}",
    "list_shares": "net usershare list",
    "delete_share": "net usershare delete {share_name}",
    "set_user_password": "smbpasswd -a {username}",
    "smb_service": "smbd",
    "nmb_service": "nmbd",
    "reload_config": "smbcontrol smbd reload-config"
  },

  "nfs": {
    "config_file": "/etc/exports",
    "export_list": "showmount -e localhost",
    "exportfs_reload": "exportfs -ra",
    "exportfs_list": "exportfs -v",
    "nfs_service": "nfs-server"
  },

  "system": {
    "hostname_set": "hostnamectl set-hostname {hostname}",
    "reboot": "systemctl reboot",
    "shutdown": "systemctl poweroff",
    "uptime": "uptime -s",
    "uname": "uname -a",
    "cpu_info": "lscpu",
    "memory_info": "free -h",
    "disk_list": "lsblk -J",
    "disk_partitions": "parted -l",
    "mount_list": "mount | column -t",
    "df": "df -h",
    "dmesg": "dmesg"
  }
}
