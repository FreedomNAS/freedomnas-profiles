{
  "os_name": "Arch Linux",
  "os_family": "linux",
  "os_version": "rolling",
  "init_system": "systemd",
  "paths": {
    "install_root": "/usr/lib/freedomnas",
    "config_dir": "/etc/freedomnas"
  },
  "community_maintained": true,
  "maintainer_note": "Community-maintained profile. Contributions welcome!",
  "packages": {
    "update_cache": "pacman -Sy",
    "list_updatable": "pacman -Qu",
    "install": "pacman -S --noconfirm {package_name}",
    "remove": "pacman -R --noconfirm {package_name}",
    "purge": "pacman -Rns --noconfirm {package_name}",
    "autoremove": "pacman -Qdtq | pacman -Rs --noconfirm -",
    "search": "pacman -Ss {package_name}",
    "show": "pacman -Si {package_name}",
    "upgrade": "pacman -Syu --noconfirm",
    "multi_args": [
      "package_name"
    ]
  },
  "bootloader": {
    "build_uki": "dracut --force --uefi --kernel-cmdline \"root=ZFS=\"{dataset}\" rw\" {output_path} {kernel_version}",
    "efi_boot_entry": "efibootmgr --create --disk {disk} --part {part_num} --loader {loader_path} --label {label}",
    "build_uki_recovery": "dracut --force --uefi --kernel-cmdline \"root=ZFS=\"{dataset}\" ro single rd.shell SYSTEMD_SULOGIN_FORCE=1\" {output_path} {kernel_version}"
  },
  "system": {
    "hostname_set": "hostnamectl set-hostname {hostname}",
    "timezone_set": "timedatectl set-timezone {timezone}",
    "timezone_get": "timedatectl show -p Timezone --value",
    "reboot": "systemctl reboot",
    "shutdown": "systemctl poweroff",
    "uptime": "uptime -s",
    "uname": "uname -a",
    "cpu_info": "lscpu",
    "memory_info": "free -h",
    "disk_list": "lsblk -J",
    "disk_partitions": "parted -l",
    "mount_list": "mount | column -t",
    "df": "df -h",
    "dmesg": "dmesg"
  },
  "updates": {
    "run_topgrade": "su - {username} -c 'topgrade --yes --config /etc/freedomnas/topgrade.toml'",
    "topgrade_config": "/etc/freedomnas/topgrade.toml"
  }
}
