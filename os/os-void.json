{
  "os_name": "Void Linux",
  "os_family": "linux",
  "os_version": "rolling",
  "init_system": "runit",
  "community_maintained": true,
  "maintainer_note": "Community-maintained profile (exotic edition). xbps userland, runit init (Void's native /etc/sv + /var/service layout, matching init/init-runit.json directly) -- no systemd anywhere in this file. ZFS is not in Void's default repos; building against a community zfs xbps template (or void-packages' zfs srcpkg) is required before this edition is installable. Contributions welcome!",
  "packages": {
    "update_cache": "xbps-install -S",
    "list_updatable": "xbps-install -un",
    "install": "xbps-install -y {package_name}",
    "remove": "xbps-remove -y {package_name}",
    "purge": "xbps-remove -Ry {package_name}",
    "autoremove": "xbps-remove -oy",
    "search": "xbps-query -Rs {package_name}",
    "show": "xbps-query -R {package_name}",
    "upgrade": "xbps-install -Suy",
    "multi_args": [
      "package_name"
    ]
  },
  "bootloader": {
    "build_uki": "dracut --force --uefi --kernel-cmdline \"root=ZFS=\"{dataset}\" rw\" {output_path} {kernel_version}",
    "efi_boot_entry": "efibootmgr --create --disk {disk} --part {part_num} --loader {loader_path} --label {label}",
    "build_uki_recovery": "dracut --force --uefi --kernel-cmdline \"root=ZFS=\"{dataset}\" ro single rd.shell SYSTEMD_SULOGIN_FORCE=1\" {output_path} {kernel_version}"
  },
  "system": {
    "hostname_set": "hostname {hostname}",
    "timezone_set": "ln -sf /usr/share/zoneinfo/{timezone} /etc/localtime",
    "timezone_get": "readlink /etc/localtime | sed 's|.*/zoneinfo/||'",
    "reboot": "reboot",
    "shutdown": "poweroff",
    "uptime": "uptime -s",
    "uname": "uname -a",
    "cpu_info": "lscpu",
    "memory_info": "free -h",
    "disk_list": "lsblk -J",
    "disk_partitions": "parted -l",
    "mount_list": "mount | column -t",
    "df": "df -h",
    "dmesg": "dmesg"
  },
  "updates": {
    "run_topgrade": "su - {username} -c 'topgrade --yes --config /etc/freedomnas/topgrade.toml'",
    "topgrade_config": "/etc/freedomnas/topgrade.toml"
  }
}
