{
  "os_name": "Void Linux",
  "os_family": "linux",
  "os_version": "rolling",
  "init_system": "runit",
  "paths": {
    "install_root": "/usr/lib/freedomnas",
    "config_dir": "/etc/freedomnas",
    "run_dir": "/run/freedomnas"
  },
  "community_maintained": true,
  "maintainer_note": "Community-maintained profile (exotic edition). xbps userland, runit init (Void's native /etc/sv + /var/service layout, found at run time by assets/runitctl through init/init-runit.json) -- no systemd anywhere in this file. ZFS is Void's own zfs package for the userland, with the kernel modules prebuilt by freedomnas-void instead of DKMS (see installer-void.json's maintainer_note). Contributions welcome!",
  "packages": {
    "update_cache": "xbps-install -S",
    "list_updatable": "xbps-install -un",
    "install": "xbps-install -y {package_name}",
    "remove": "xbps-remove -y {package_name}",
    "purge": "xbps-remove -Ry {package_name}",
    "autoremove": "xbps-remove -oy",
    "search": "xbps-query -Rs {package_name}",
    "show": "xbps-query -R {package_name}",
    "upgrade": "xbps-install -Suy",
    "module_search": "xbps-query -Rs freedomnas-module- | awk '{{n = $2; sub(/-[^-]*$/, \"\", n); v = substr($2, length(n) + 2); $1 = \"\"; $2 = \"\"; sub(/^ +/, \"\"); print n \"\\t\" v \"\\t\" $0}}'",
    "module_installed": "xbps-query -s freedomnas-module- | awk '{{n = $2; sub(/-[^-]*$/, \"\", n); v = substr($2, length(n) + 2); $1 = \"\"; $2 = \"\"; sub(/^ +/, \"\"); print n \"\\t\" v \"\\t\" $0}}'",
    "module_pattern": "(?:[a-z0-9][a-z0-9+_.-]*/)?freedomnas-module-([a-z0-9][a-z0-9_-]{0,62})",
    "module_remove": "xbps-remove -y {package_name}",
    "_note_modules": "module_search / module_installed: community modules are the packages named freedomnas-module-<id>; one line per package: name<TAB>version<TAB>description. module_search reads the local package index (update_cache refreshes it).",
    "multi_args": [
      "package_name"
    ]
  },
  "bootloader": {
    "uki_backup": "/usr/lib/freedomnas/profiles/assets/zz-dracut-uki --backup {snapshot}",
    "boot_ok": "/usr/lib/freedomnas/profiles/assets/zz-dracut-uki --boot-ok {autorollback}",
    "autorollback_set": "/usr/lib/freedomnas/profiles/assets/zz-dracut-uki --autorollback {autorollback}",
    "boot_state": "/usr/lib/freedomnas/profiles/assets/zz-dracut-uki --state",
    "rollback_forget": "/usr/lib/freedomnas/profiles/assets/zz-dracut-uki --forget-rollback",
    "firmware_mode": "test -d /sys/firmware/efi && echo UEFI || echo BIOS",
    "build_uki": "dracut --force --uefi --kernel-cmdline \"root=ZFS=\"{dataset}\" rw\" {output_path} {kernel_version}",
    "efi_boot_entry": "efibootmgr --create --disk {disk} --part {part_num} --loader {loader_path} --label {label}",
    "build_uki_recovery": "dracut --force --uefi --kernel-cmdline \"root=ZFS=\"{dataset}\" ro single rd.shell SYSTEMD_SULOGIN_FORCE=1\" {output_path} {kernel_version}"
  },
  "system": {
    "ssh_service": "sshd",
    "hostname_set": "sh -c 'printf \"%s\\n\" \"$1\" > /etc/hostname && hostname \"$1\"' hostname_set {hostname}",
    "timezone_set": "ln -sf /usr/share/zoneinfo/{timezone} /etc/localtime",
    "timezone_get": "readlink /etc/localtime | sed 's|.*/zoneinfo/||'",
    "reboot": "reboot",
    "shutdown": "poweroff",
    "uptime": "uptime -s",
    "uname": "uname -a",
    "cpu_info": "lscpu",
    "memory_info": "free -h",
    "disk_list": "lsblk -J",
    "disk_partitions": "parted -l",
    "mount_list": "mount | column -t",
    "df": "df -h",
    "dmesg": "dmesg",
    "ssh_host_key_dir": "/etc/ssh"
  },
  "updates": {
    "run_topgrade": "su - {username} -c 'topgrade --yes --no-self-update --config /etc/freedomnas/topgrade.toml'",
    "topgrade_config": "/etc/freedomnas/topgrade.toml"
  },
  "power_button": {
    "category": "power-button",
    "rule_dir": "/etc/acpi/events",
    "rule_file": "/etc/acpi/events/freedomnas-power",
    "rule": "# FreedomNAS: a press of the power button shuts the NAS down.\nevent=button/power.*\naction=/bin/sh -c poweroff\n",
    "service": "acpid"
  }
}
