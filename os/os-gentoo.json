{
  "os_name": "Gentoo",
  "os_family": "linux",
  "os_version": "rolling",
  "init_system": "openrc",
  "paths": {
    "install_root": "/usr/lib/freedomnas",
    "config_dir": "/etc/freedomnas"
  },
  "community_maintained": true,
  "maintainer_note": "Community-maintained profile. Portage userland, OpenRC init (init/init-openrc.json). A Gentoo/systemd install works too — the engine detects the running init at runtime; only the installer's target defaults to OpenRC, matching the openrc stage3. Package atoms are given in full category/name form and were validated against the ::gentoo tree; OpenRC service names come from the init scripts the corresponding ebuilds install. Persistent hostname lives in /etc/conf.d/hostname (written by the installer); system.hostname_set only changes the running one, as on Void.",
  "packages": {
    "update_cache": "emerge --sync --quiet",
    "list_updatable": "emerge --pretend --update --deep --newuse --quiet --color=n @world | grep -E '^\\[(ebuild|binary)'",
    "install": "emerge --quiet --noreplace {package_name}",
    "remove": "emerge --deselect {package_name}",
    "purge": "emerge --unmerge --quiet {package_name}",
    "autoremove": "emerge --depclean --quiet",
    "search": "emerge --search {package_name}",
    "show": "emerge --pretend --verbose {package_name}",
    "upgrade": "emerge --update --deep --newuse --quiet @world",
    "multi_args": [
      "package_name"
    ]
  },
  "bootloader": {
    "build_uki": "dracut --force --uefi --kernel-cmdline \"root=ZFS=\"{dataset}\" rw\" {output_path} {kernel_version}",
    "build_uki_recovery": "dracut --force --uefi --kernel-cmdline \"root=ZFS=\"{dataset}\" ro single rd.shell SYSTEMD_SULOGIN_FORCE=1\" {output_path} {kernel_version}",
    "efi_boot_entry": "efibootmgr --create --disk {disk} --part {part_num} --loader {loader_path} --label {label}"
  },
  "system": {
    "hostname_set": "hostname {hostname}",
    "timezone_set": "ln -sf /usr/share/zoneinfo/{timezone} /etc/localtime",
    "timezone_get": "readlink /etc/localtime | sed 's|.*/zoneinfo/||'",
    "reboot": "openrc-shutdown --reboot now",
    "shutdown": "openrc-shutdown --poweroff now",
    "uptime": "uptime -s",
    "uname": "uname -a",
    "cpu_info": "lscpu",
    "memory_info": "free -h",
    "disk_list": "lsblk -J",
    "disk_partitions": "parted -l",
    "mount_list": "mount | column -t",
    "df": "df -h",
    "dmesg": "dmesg"
  },
  "updates": {
    "run_topgrade": "su - {username} -c 'topgrade --yes --config /etc/freedomnas/topgrade.toml'",
    "topgrade_config": "/etc/freedomnas/topgrade.toml",
    "topgrade_extra_config": "[linux]\nemerge_update_flags = \"-uDN --with-bdeps=y world\"\n"
  }
}
