{
  "os_name": "Artix Linux",
  "os_family": "linux",
  "os_version": "rolling",
  "init_system": "openrc",
  "paths": {
    "install_root": "/usr/lib/freedomnas",
    "config_dir": "/etc/freedomnas"
  },
  "community_maintained": true,
  "maintainer_note": "Community-maintained profile (exotic edition). Arch userland (pacman) with OpenRC instead of systemd -- no hostnamectl/systemctl anywhere in this file. Package/service names inherited from arch.json where OpenRC does not change them; samba/nfs OpenRC service names should be validated against the current artix-openrc-base package set before relying on them in production. Contributions welcome!",
  "packages": {
    "update_cache": "pacman -Sy",
    "list_updatable": "pacman -Qu",
    "install": "pacman -S --noconfirm {package_name}",
    "remove": "pacman -R --noconfirm {package_name}",
    "purge": "pacman -Rns --noconfirm {package_name}",
    "autoremove": "pacman -Qdtq | pacman -Rs --noconfirm -",
    "search": "pacman -Ss {package_name}",
    "show": "pacman -Si {package_name}",
    "upgrade": "pacman -Syu --noconfirm",
    "multi_args": [
      "package_name"
    ]
  },
  "bootloader": {
    "uki_backup": "/usr/lib/freedomnas/profiles/assets/zz-dracut-uki --backup {snapshot}",
    "firmware_mode": "test -d /sys/firmware/efi && echo UEFI || echo BIOS",
    "build_uki": "dracut --force --uefi --kernel-cmdline \"root=ZFS=\"{dataset}\" rw\" {output_path} {kernel_version}",
    "efi_boot_entry": "efibootmgr --create --disk {disk} --part {part_num} --loader {loader_path} --label {label}",
    "build_uki_recovery": "dracut --force --uefi --kernel-cmdline \"root=ZFS=\"{dataset}\" ro single rd.shell SYSTEMD_SULOGIN_FORCE=1\" {output_path} {kernel_version}"
  },
  "system": {
    "ssh_service": "sshd",
    "hostname_set": "hostname {hostname}",
    "timezone_set": "ln -sf /usr/share/zoneinfo/{timezone} /etc/localtime",
    "timezone_get": "readlink /etc/localtime | sed 's|.*/zoneinfo/||'",
    "reboot": "reboot",
    "shutdown": "poweroff",
    "uptime": "uptime -s",
    "uname": "uname -a",
    "cpu_info": "lscpu",
    "memory_info": "free -h",
    "disk_list": "lsblk -J",
    "disk_partitions": "parted -l",
    "mount_list": "mount | column -t",
    "df": "df -h",
    "dmesg": "dmesg"
  },
  "updates": {
    "run_topgrade": "su - {username} -c 'topgrade --yes --config /etc/freedomnas/topgrade.toml'",
    "topgrade_config": "/etc/freedomnas/topgrade.toml"
  }
}
